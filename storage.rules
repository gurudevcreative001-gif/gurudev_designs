rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Customer reference photo and logo uploads for new orders
    match /order-uploads/{sessionId}/{fileName} {
      allow write: if sessionId.matches('^[a-zA-Z0-9_\\-]{8,64}$')
                   && fileName.size() <= 160
                   && request.resource != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType == 'application/pdf'
                   );
      allow read: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == 'rakeshpatel144589@gmail.com';
    }

    // Public branding, service, and portfolio gallery assets managed by Admin
    match /public-assets/{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email_verified == true
                   && request.auth.token.email == 'rakeshpatel144589@gmail.com'
                   && request.resource != null
                   && request.resource.size <= 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
